{
  "name": "meraki-cms",
  "version": "3.1.1",
  "description": "Meraki CMS – Modulares Restaurant Management System (Speisekarte, Reservierungen, Website-Editor)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js | pino-pretty",
    "dev:web": "npm --prefix web run dev",
    "dev:all": "concurrently -n api,web -c blue,magenta \"npm run dev\" \"npm run dev:web\"",
    "build:web": "npm --prefix web run build",
    "install:web": "npm --prefix web install",
    "reset-admin": "node reset-admin.js",
    "update": "git pull && npm install --silent && npm --prefix web install --silent && npm run build:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@meraki/plans": "github:stb-srv/meraki-plans",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.2",
    "file-type": "^16.5.4",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.11.5",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.18.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sanitize-html": "^2.17.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "playwright": "^1.60.0",
    "prettier": "^3.0.0"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true
  }
}
